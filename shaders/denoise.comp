#version 460
#extension GL_GOOGLE_include_directive : require
// Denoiser for the progressive path tracer: an edge-avoiding à-trous wavelet
// filter (Dammertz et al., "Edge-avoiding À-Trous wavelet transform for fast
// global illumination filtering", 2010) steered by the variance of the
// accumulated samples, as in SVGF (Schied et al., 2017), but spatial only since
// the path tracer accumulates a still image.
//
// Pass 0 turns the accumulation into mean irradiance (radiance divided by the
// first-hit albedo, so texture is not blurred) plus its variance; passes 1..N
// filter with growing step, ping-ponging between two images; the last pass
// multiplies the albedo back in and writes the HDR image. As samples grow the
// variance, and with it the blur, goes to zero: the result converges to the
// path-traced image.

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 17, rgba32f) uniform readonly image2D accum_image;
layout(set = 0, binding = 18, rgba32f) uniform readonly image2D guide_albedo_image;
layout(set = 0, binding = 19, rgba32f) uniform readonly image2D guide_normal_image;
layout(set = 0, binding = 20, rgba32f) uniform image2D ping_image;  // rgb irradiance, a variance
layout(set = 0, binding = 21, rgba32f) uniform image2D pong_image;

layout(push_constant) uniform Push {
    ivec4 target_dims;
    ivec4 params;  // x: pass (0 prepare, 1.. filter, -1 finish), y: step in pixels, z: 1 = read pong
} pc;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float samples() {
    return float(u.path.x + u.path.z);
}

vec3 mean_albedo(ivec2 p) {
    return max(imageLoad(guide_albedo_image, p).rgb / samples(), vec3(0.02));
}

vec4 mean_normal_depth(ivec2 p) {
    vec4 g = imageLoad(guide_normal_image, p) / samples();
    float len = length(g.xyz);
    return vec4(len > 1e-3 ? g.xyz / len : vec3(0.0), g.w);
}

vec4 load(ivec2 p, bool from_pong) {
    return from_pong ? imageLoad(pong_image, p) : imageLoad(ping_image, p);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(u.flags.zw);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    int pass = pc.params.x;
    float n = samples();

    if (pass == 0) {
        vec3 radiance = imageLoad(accum_image, p).rgb / n;
        vec3 irradiance = radiance / mean_albedo(p);
        // Variance of the mean luminance: the per-pixel estimate, and the spread
        // over the neighbourhood, which covers pixels whose few samples happened to
        // agree (e.g. all dark) and fades out as samples accumulate.
        float l = luminance(radiance);
        float temporal = max(imageLoad(guide_albedo_image, p).a / n - l * l, 0.0) / n;
        float s1 = 0.0;
        float s2 = 0.0;
        for (int y = -2; y <= 2; y++) {
            for (int x = -2; x <= 2; x++) {
                ivec2 q = clamp(p + ivec2(x, y), ivec2(0), size - 1);
                float lq = luminance(imageLoad(accum_image, q).rgb / n);
                s1 += lq;
                s2 += lq * lq;
            }
        }
        float spatial = max(s2 / 25.0 - (s1 / 25.0) * (s1 / 25.0), 0.0);
        float variance = max(temporal, spatial * min(1.0, 4.0 / n));
        // Irradiance variance, relative to the albedo's luminance.
        float a = luminance(mean_albedo(p));
        imageStore(ping_image, p, vec4(irradiance, variance / (a * a)));
        return;
    }

    bool from_pong = pc.params.z != 0;
    if (pass < 0) {
        vec3 irradiance = load(p, from_pong).rgb;
        float background = imageLoad(accum_image, p).a / n;
        imageStore(hdr_image, p, vec4(irradiance * mean_albedo(p), background));
        return;
    }

    // One à-trous level: 5x5 B3-spline taps `step` pixels apart, weighted by how
    // similar each neighbour is in normal, depth, albedo and irradiance.
    int step = pc.params.y;
    vec4 center = load(p, from_pong);
    vec4 geometry = mean_normal_depth(p);
    vec3 albedo = mean_albedo(p);
    float l_center = luminance(center.rgb);
    // The variance steering the luminance weight is itself noisy: blur it 3x3.
    float blurred_variance = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), size - 1);
            blurred_variance += load(q, from_pong).a * float((2 - abs(x)) * (2 - abs(y))) / 16.0;
        }
    }
    float sigma_l = 4.0 * sqrt(max(blurred_variance, 0.0)) + 1e-4;
    const float kernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

    vec3 sum = vec3(0.0);
    float variance = 0.0;
    float weights = 0.0;
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            ivec2 q = p + ivec2(x, y) * step;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) {
                continue;
            }
            vec4 c = load(q, from_pong);
            vec4 g = mean_normal_depth(q);
            float w_normal = pow(max(dot(geometry.xyz, g.xyz), 0.0), 64.0);
            if (dot(geometry.xyz, geometry.xyz) < 0.5 || dot(g.xyz, g.xyz) < 0.5) {
                w_normal = float(dot(geometry.xyz, geometry.xyz) < 0.5 && dot(g.xyz, g.xyz) < 0.5);
            }
            float w_depth = exp(-abs(geometry.w - g.w) / (0.02 * geometry.w + 1e-3));
            vec3 da = albedo - mean_albedo(q);
            float w_albedo = exp(-dot(da, da) / 0.01);
            float w_luminance = exp(-abs(l_center - luminance(c.rgb)) / sigma_l);
            float w = kernel[abs(x)] * kernel[abs(y)] * w_normal * w_depth * w_albedo * w_luminance;
            sum += w * c.rgb;
            variance += w * w * c.a;
            weights += w;
        }
    }
    vec4 filtered = weights > 0.0 ? vec4(sum / weights, variance / (weights * weights)) : center;
    if (from_pong) {
        imageStore(ping_image, p, filtered);
    } else {
        imageStore(pong_image, p, filtered);
    }
}
