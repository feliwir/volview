#version 460
#extension GL_GOOGLE_include_directive : require
// Exposure, camera finishing (bloom, vignette, film grain; see bloom.comp),
// tone mapping and background compositing of the HDR render.

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 32) uniform sampler2D bloom_narrow;  // quarter resolution
layout(set = 0, binding = 33) uniform sampler2D bloom_wide;    // eighth resolution
layout(set = 0, binding = 34, r32f) uniform readonly image2D exposure_image;

// Uniform [0, 1) from an integer (PCG hash, Jarzynski and Olano 2020).
float hash01(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return float((word >> 22u) ^ word) * (1.0 / 4294967296.0);
}

// Narkowicz's fit of the ACES filmic curve.
vec3 aces(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// AgX base look (Troy Sobotka), with the polynomial sigmoid fit by Benjamin Wrensch.
vec3 agx(vec3 c) {
    const mat3 inset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051,
                            0.0784335999999992, 0.878468636469772, 0.0784336,
                            0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 outset = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438,
                             -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
                             -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    const float min_ev = -12.47393;
    const float max_ev = 4.026069;
    c = inset * c;
    c = clamp(log2(max(c, 1e-10)), min_ev, max_ev);
    c = (c - min_ev) / (max_ev - min_ev);
    vec3 c2 = c * c;
    vec3 c4 = c2 * c2;
    c = 15.5 * c4 * c2 - 40.14 * c4 * c + 31.96 * c4 - 6.868 * c2 * c + 0.4298 * c2 + 0.1191 * c - 0.00232;
    c = outset * c;
    // The sigmoid outputs display-encoded values; decode to linear for sRGB encoding later.
    return pow(clamp(c, 0.0, 1.0), vec3(2.2));
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, u.flags.zw))) {
        return;
    }
    vec4 hdr = imageLoad(hdr_image, ivec2(pixel));
    float exposure = u.ambient.w;
    if (u.finish.w > 0.5) {
        exposure *= imageLoad(exposure_image, ivec2(0)).r;
    }
    vec3 c = hdr.rgb;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(u.flags.zw);
    if (u.finish.x > 0.0) {
        // Bloom: a small share of the light spreads into a narrow and a wide
        // glow, as by scattering in a real lens (energy is kept: mix).
        vec3 glow = 0.6 * textureLod(bloom_narrow, uv, 0.0).rgb + 0.4 * textureLod(bloom_wide, uv, 0.0).rgb;
        c = mix(c, glow, u.finish.x);
    }
    // Vignette: light falls off towards the corners of the frame.
    float r = length(uv * 2.0 - 1.0) * 0.7071;
    float vignette = 1.0 - u.finish.y * pow(r, 2.5);
    c *= exposure * vignette;
    uint op = uint(u.material.z);
    c = op == 1u ? aces(c) : op == 2u ? agx(c) : clamp(c, 0.0, 1.0);
    // The background is display-referred and not affected by exposure.
    c += hdr.a * background(camera_ray(vec2(pixel) + 0.5));
    if (u.flags.y != 0u) {
        c = linear_to_srgb(c);
    }
    if (u.finish.z > 0.0) {
        // Film grain: fixed per pixel (it does not crawl while the path tracer
        // converges), roughly Gaussian (sum of two uniforms), strongest in the
        // mid-tones. Added to display values, where it is perceptually even.
        float n = hash01(pixel.x + 4099u * pixel.y) + hash01(pixel.x * 7919u + pixel.y + 1u) - 1.0;
        float y = clamp(dot(c, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
        c = clamp(c + n * u.finish.z * (0.3 + 2.8 * y * (1.0 - y)), 0.0, 1.0);
    }
    imageStore(out_image, ivec2(pixel), vec4(c, 1.0));
}
