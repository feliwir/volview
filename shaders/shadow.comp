#version 460
#extension GL_GOOGLE_include_directive : require
// Transmittance towards the key light, swept slice by slice away from the light
// (after Ropinski et al., "Interactive volumetric lighting simulating scattering
// and shadowing", 2010). Each dispatch computes one slice perpendicular to the
// light's dominant axis from the previous one, so a full update costs one
// sample per voxel.

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Push {
    ivec4 target_dims;  // xyz: shadow volume size
    ivec4 sweep;        // x: sweep axis, y: slice index, z: +1/-1 = light side of the axis
} pc;

void main() {
    ivec3 p;
    int axis = pc.sweep.x;
    int u_axis = (axis + 1) % 3;
    int v_axis = (axis + 2) % 3;
    p[axis] = pc.sweep.y;
    p[u_axis] = int(gl_GlobalInvocationID.x);
    p[v_axis] = int(gl_GlobalInvocationID.y);
    if (any(greaterThanEqual(p, pc.target_dims.xyz))) {
        return;
    }
    vec3 sdims = vec3(pc.target_dims.xyz);

    // Light direction in shadow-volume index units per mm.
    vec3 l_idx = (mat3(u.world_to_index) * u.light_dir.xyz) * (sdims / u.dims.xyz);
    // Step towards the light until the previous slice: `s` mm along the light.
    float s = 1.0 / max(abs(l_idx[axis]), 1e-6);
    vec3 here = vec3(p);
    vec3 prev = here + l_idx * s;

    // Optical depth of the segment, sampled at its midpoint in the full-res volume.
    vec3 mid_tex = ((here + prev) * 0.5 + 0.5) / sdims;
    Sample m = sample_point(tex_to_index(mid_tex));
    // Outside the volume the border colour (white) supplies full transmittance.
    float direct = textureLod(shadow_tex, (prev + 0.5) / sdims, 0.0).a * exp(-m.extinction * s);

    // Diffused light for subsurface scattering (after Kniss et al., "A model for
    // volumetric lighting and modeling", 2003): gathered from a small disc of the
    // previous slice, so it spreads sideways as it travels, and attenuated per
    // colour channel. The attenuation follows the material's hue: a reddish
    // tissue absorbs green and blue much more than red, so light travels further
    // in red and the tissue glows red, as real tissue does.
    vec3 axis_u = vec3(0.0);
    vec3 axis_v = vec3(0.0);
    axis_u[u_axis] = u.subsurface.z;
    axis_v[v_axis] = u.subsurface.z;
    vec3 gathered = 0.4 * textureLod(shadow_tex, (prev + 0.5) / sdims, 0.0).rgb;
    for (int i = 0; i < 4; i++) {
        vec3 offset = (i & 1) == 0 ? axis_u : axis_v;
        offset *= i < 2 ? 1.0 : -1.0;
        gathered += 0.15 * textureLod(shadow_tex, (prev + offset + 0.5) / sdims, 0.0).rgb;
    }
    vec3 chroma = m.albedo / max(max(m.albedo.r, max(m.albedo.g, m.albedo.b)), 1e-4);
    vec3 indirect_extinction = m.extinction * u.subsurface.y * (1.2 - chroma);
    vec3 indirect = gathered * exp(-indirect_extinction * s);
    imageStore(shadow_image, p, vec4(indirect, direct));
}
